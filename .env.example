# App config
WEB_NAME="be-lokerku-api"
BASE_URL="http://localhost:5001"
PORT=5001

# JWT
AUTH_SECRET="your-auth-secret"
JWT_SECRET="your-jwt-secret"

# Database (MySQL)
DB_USERNAME="root"
DB_PASSWORD=""
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DIALECT="mysql"
DB_NAME_DEVELOPMENT="db_be_lokerku_api"
DB_NAME_PRODUCTION=

# CORS - comma-separated list of allowed origins
# Leave empty to auto-allow .vercel.app domains
CORS_ORIGINS=https://your-frontend.vercel.app,https://yourdomain.com
